close all;
clear all

load drgania_wlasne_2.mat

%start = 1583; % start for drgania_wlasne_1
start = 900; % start for drgania_wlasne_2

tm = StateData.time(start:end);
ym = StateData.signals(7).values(start:end);
u = StateData.signals(1).values(start:end);
tm = tm - tm(1);


% tutaj troche nietypowe rozwiązanie ale do optymalizacji dodane jest 
% x0 (punkt początkowy) nie jest to potrzebne ale zostało mi to w kodzie 
% a to bardzo prosta identyfikacja to już zostawiłem, w ident ze sterowaniem 
% już jest normalnie bez tego 

x0(1,1)=ym(1,1);
x0(2,1)=0;
a=0.1;b=-3.9;xopt=[x0;a;b];

LB=[-10 -10 -100 -10]';UB=[10 10 100 10]';
options=optimset('display','iter');

[xopt,resnorm,residual,exitflag,output,lambda,jacobian]=...
lsqnonlin('cel',xopt,LB,UB,options,u,tm,ym);

x0=xopt(1:2);a=xopt(3);b=xopt(4);
[t,x]=rk4(x0,u,tm(end),a,b);
plot(t,x(:,1),tm,ym(:,1));grid

legend("symulacja", "pomiary");xlabel('t [s]');ylabel('x1');
title("Identyfikacja")

fprintf("a = %f\n", a)
fprintf("b = %f\n", b)








